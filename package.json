  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/Daevashan/playwright-ts-automation-framework/issues"
  },
  "homepage": "https://github.com/Daevashan/playwright-ts-automation-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3"
  }
}
